TROLLEY_DATABASE_URL=sqlite://./trolley.db
TROLLEY_PUBLIC_BASE_URL=http://localhost:8000
TROLLEY_TARGETS_FILE=./targets.yaml

# Only these normalized emails may hold the admin role.
TROLLEY_ADMIN_EMAILS=admin@example.com

# Target connection settings live in TROLLEY_TARGETS_FILE.

# Optional SMTP delivery for invite_user. Leave SMTP_HOST unset to disable it.
TROLLEY_EMAIL_FROM=Trolley <trolley@example.com>
TROLLEY_SMTP_HOST=smtp.example.com
TROLLEY_SMTP_PORT=587
TROLLEY_SMTP_USERNAME=trolley@example.com
TROLLEY_SMTP_PASSWORD=replace-me
TROLLEY_SMTP_SECURITY=starttls
TROLLEY_SMTP_TIMEOUT=10
