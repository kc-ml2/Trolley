TROLLEY_DATABASE_URL=sqlite://./trolley.db
TROLLEY_PUBLIC_BASE_URL=http://localhost:8000

# Only these normalized emails may hold the admin role.
TROLLEY_ADMIN_EMAILS=admin@example.com

# Used only when the user table is empty. Keep this key secret.
TROLLEY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TROLLEY_BOOTSTRAP_ADMIN_API_KEY=sk-trolley-change-me

# PostgreSQL target credentials
# CUSTOMER_DATABASE_URL=postgresql://user:password@localhost/customers

# HTTP target credentials
# ORDERS_API_TOKEN=replace-me
